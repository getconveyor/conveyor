# ==============================================
# Conveyor Platform Environment Configuration
# ==============================================
# Copy this file to .env and update with your values
# DO NOT commit .env to version control

# ----------------------------------------------
# Application
# ----------------------------------------------
NODE_ENV=production
DEBUG=True
BUILD_TARGET=runner

# ----------------------------------------------
# Django
# ----------------------------------------------
SECRET_KEY=j+ok7x+9&uwwywzp&(p1b#^nxje&=ct4t0$s%^ix*4@=#j^y(m
ALLOWED_HOSTS=localhost,127.0.0.1,server

# ----------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=conveyor
POSTGRES_USER=conveyor
POSTGRES_PASSWORD=conveyor_password

# ----------------------------------------------
# Redis (Cache & Celery Broker)
# ----------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ----------------------------------------------
# MinIO/S3 (Object Storage)
# ----------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=conveyor-storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ----------------------------------------------
# Application Ports
# ----------------------------------------------
WEB_PORT=3000
SERVER_PORT=8000

# ----------------------------------------------
# CORS Configuration
# ----------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----------------------------------------------
# Next.js API URL
# ----------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ----------------------------------------------
# JWT Configuration
# ----------------------------------------------
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ----------------------------------------------
# External Services (Optional)
# ----------------------------------------------
# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True

# Slack
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# ----------------------------------------------
# Monitoring (Optional)
# ----------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ----------------------------------------------
# Feature Flags
# ----------------------------------------------
ENABLE_REAL_TIME=true
ENABLE_ML_FEATURES=true
ENABLE_GOVERNANCE=true
